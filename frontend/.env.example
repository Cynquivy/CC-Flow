# Base URL of the backend API, prepended to every /api/... request.
# Required for local dev, where the frontend (5173) and backend (8000) run as
# separate servers. Leave unset in production (Vercel) -- there frontend and
# backend share one domain via vercel.json's services/rewrites, so requests
# should go to the same-origin relative /api/... path instead.
VITE_API_URL=http://localhost:8000
